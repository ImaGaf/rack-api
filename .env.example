# Copy this file to .env and fill in the values. Nested keys use "__" (e.g. SendGrid__ApiKey -> SendGrid:ApiKey)
ConnectionStrings__DefaultConnection="data source=<host>;Initial Catalog=RackLogic;User Id=<user>;Password=<password>;Persist Security Info=True; TrustServerCertificate=True; Encrypt=false"
ConnectionStrings__AcsConnection=
TokenSettings__SecretKey=
SendGrid__ApiKey=
